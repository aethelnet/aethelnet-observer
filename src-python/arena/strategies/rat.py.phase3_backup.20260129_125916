    def next_candle(self, df: pd.DataFrame) -> float:
        """
        Analyzes the last few candles to detect 'Panic Wicks'.
        """
        if len(df) < 5:
            return 0.0
            
        # CALIBRATION LAYER
        eff = self._get_effective_skills()
        effective_sensitivity = eff['sensitivity']

        # 1. Calculate Volatility
        closes = df['close']
        recent_volatility = closes.pct_change().std()
        
        # 2. Analyze the latest candle
        current = df.iloc[-1]
        prev = df.iloc[-2]
        
        change_pct = (current['close'] - prev['close']) / prev['close']
        
        # 3. The Wick Hunter Logic
        sigma = abs(change_pct) / (recent_volatility + 1e-9)
        
        if sigma > effective_sensitivity:
            # We found a tasty crumb (Panic Move)
            
            # CUSP INTENSITY
            intensity = 1.0
            if sigma > (effective_sensitivity + 1.0):
                intensity = 2.0 
                logger.info(f"[Rat] SCORPIO CUSP TRIGGERED (Sigma: {sigma:.2f}). MAX INTENSITY.")
            
            if change_pct > 0:
                return -1.0 * intensity
            else:
                return 1.0 * intensity
                
        return 0.0 

