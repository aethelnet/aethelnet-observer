# =============================================================================
# MINIMAL .env FOR LIVE TRADING
# =============================================================================
# Copy this file to .env in the project root and fill in your API keys
# Only essential settings are included - everything else uses safe defaults
# =============================================================================

# =============================================================================
# 🔴 CRITICAL: API Keys for Live Trading
# =============================================================================
# Get these from: https://www.binance.com/en/my/settings/api-management
# ⚠️ WARNING: These keys can access your real money account!
BINANCE_API_KEY=your_live_api_key_here
BINANCE_SECRET_KEY=your_live_secret_key_here

# =============================================================================
# 🔴 CRITICAL: Trading Mode
# =============================================================================
# Set to false for LIVE TRADING (real money!)
BINANCE_TESTNET=false

# Must match BINANCE_TESTNET:
# - "testnet" = safe testing (use with BINANCE_TESTNET=true)
# - "production" = live trading (use with BINANCE_TESTNET=false)
ENV_MODE=production

# Enable actual trade execution
EXECUTION_ENABLED=true

# =============================================================================
# 🟡 IMPORTANT: Core Trading Settings
# =============================================================================
# Max position size as % of account (0.05 = 5% per trade)
MAX_POSITION_SIZE=0.05

# Minimum hold time in seconds (prevents whipsaw trades)
MIN_HOLD_TIME=45

# Signal strength threshold (0.1-1.0, lower = more trades)
SIGNAL_THRESHOLD=0.65

# Require N confirming signals before trading
SIGNAL_PERSISTENCE=2

# Daily loss limit in USD (stops trading if exceeded)
MAX_DAILY_LOSS=500.0

# Trading pairs - Simplified format (recommended)
# Automatically generates all combinations: BTCUSDC, BTCEUR, ETHUSDC, ETHEUR, etc.
BASE_CURRENCIES=BTC,ETH,SOL,ADA,DOT,LINK,AVAX,MATIC
QUOTE_CURRENCIES=USDC,EUR

# Or use explicit list (legacy format - only used if BASE_CURRENCIES/QUOTE_CURRENCIES not set)
# SYMBOLS_WHITELIST=BTCUSDC,ETHUSDC,SOLUSDC,BTCEUR,ETHEUR

# =============================================================================
# 🟢 OPTIONAL: Uncomment to customize (or leave commented for defaults)
# =============================================================================

# Trading style
# TRADE_FREQUENCY=HIGH
# RISK_TOLERANCE=AGGRESSIVE
# PROFIT_TARGET=0.02
# STOP_LOSS=0.01
# TRAILING_STOP=true
# SCALPING_MODE=true

# Shadow Engine (parallel trading)
# SHADOW_ENGINE_ENABLED=true
# SHADOW_MIN_HOLD_TIME=10
# SHADOW_SIGNAL_THRESHOLD=0.65
# SHADOW_POSITION_SIZE=0.05
# SHADOW_MAX_POSITIONS=3

# Monitoring
# SENTINEL_ENABLED=true
# ARENA_ENABLED=true

# Symbol Recommendations (Phase 2: Manual Recommendations)
# AUTO_SYMBOL_SUGGESTIONS=true  # Enable periodic symbol recommendation reports
# SYMBOL_REPORT_INTERVAL_HOURS=24  # Generate reports every 24 hours (weekly=168, monthly=720)
# SYMBOL_REPORT_MIN_TRADES=10  # Minimum trades before recommending symbol removal

# Auto-Discovery Engine (Phase 3: Finding Markets to Farm)
# RESERVE_PERCENTAGE=0.5  # 50% kept safe in stablecoin (USDC/EUR)
# AUTO_DISCOVERY_ENABLED=false  # Enable automatic symbol discovery and trading
# AUTO_DISCOVERY_BUDGET_PCT=0.5  # 50% of trading pool goes to auto-discovery (25% of total)
# AUTO_DISCOVERY_MIN_SIGNAL=0.7  # Only trade discovered symbols with strong signals (0.0-1.0)
# AUTO_DISCOVERY_MAX_SYMBOLS=5  # Maximum concurrent discovered symbols
# AUTO_DISCOVERY_REBALANCE_HOURS=24  # Rebalance allocation daily (remove underperformers)
# AUTO_DISCOVERY_DISCOVERY_INTERVAL_MINUTES=5  # Run discovery scan every 5 minutes

# Notifications
# DISCORD_WEBHOOK_URL=
# NOTIFICATION_EMAIL=

# Alpaca API (for stock trading - optional)
# ALPACA_API_KEY=your_alpaca_api_key
# ALPACA_SECRET_KEY=your_alpaca_secret_key
# ALPACA_PAPER=false  # Set to true for paper trading
# ALPACA_EXTENDED_HOURS=false  # Enable pre-market/after-hours trading

# Regional settings (for regulatory compliance)
# REGION=EU  # Set to 'EU' or 'EUROPE' for European regulatory warnings

# Debugging
# DEBUG_MODE=false
# VERBOSE_LOGGING=false

# =============================================================================
# 🟢 OPTIONAL: ALPHA Mode Access Control
# =============================================================================
# ALPHA_OVERRIDE=true  # Force ALPHA mode (dev/test only - bypasses all checks)
# ADMIN_TOKEN=your_secret_token_here  # Primary entry method for ALPHA mode



