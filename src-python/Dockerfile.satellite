# Use a slim Python image for the compute node
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for math/numba
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies - LIGHTWEIGHT
RUN pip install --no-cache-dir websockets aiohttp numpy ccxt

# Copy ONLY the self-contained satellite node
COPY backend/satellite_node.py .

# Environment Defaults
ENV NEXUS_URL=ws://your-nexus-url.railway.app
ENV PYTHONUNBUFFERED=1

CMD ["python", "satellite_node.py"]
